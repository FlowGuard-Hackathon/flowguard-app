# Copiar a .env.local (nunca se sube a Git). Ver flowguard-src/.env.example
# para las variables que lee flowguard-src directamente (agente, Nebius).

# Persistencia (app/lib/almacenPrueba.ts). Si se define SUPABASE_DB_URL, la
# app usa el esquema real de flowguard-supabase/migrations (idempotencia,
# investigación asíncrona con worker, rate limiting). Si solo se define
# DATABASE_URL, usa el esquema simplificado histórico (docker/init.sql,
# ahora igual al real — ver ese archivo). Si no se define ninguna, usa
# memoria (se pierde al reiniciar `npm run dev`).
SUPABASE_DB_URL=postgres://flowguard:flowguard@localhost:5544/flowguard
# DATABASE_URL=

# Agente de IA (igual que flowguard-src/.env.example; Next.js también las lee
# del .env.local de este repo si no se exportan desde el proceso padre).
AGENTE_PROVEEDOR=simulado
NEBIUS_CLAVE_API=replace_with_secret
NEBIUS_URL_BASE=replace_with_verified_endpoint
NEBIUS_MODELO=replace_with_supported_model_id
AGENTE_MAX_LLAMADAS_HERRAMIENTAS=5
AGENTE_TIEMPO_LIMITE_MS=15000
AGENTE_CONCURRENCIA_PROCESOS=2
AGENTE_INTERVALO_SONDEO_MS=2000
RECONCILIADOR_INTERVALO_MS=60000

# Límite de solicitudes (middleware.ts, seguridad.md § 2.4). Desactivado por
# defecto en desarrollo local.
LIMITE_SOLICITUDES_ACTIVO=false
# ENCABEZADO_PROXY_CONFIABLE=

# Basic Auth de la demo pública (seguridad.md § 2.0). Solo si se expone una
# URL pública. Nunca en Git.
# DEMO_AUTH_BASICA_USUARIO=
# DEMO_AUTH_BASICA_CONTRASENA=

# Login (app/lib/auth.ts, next-auth v5) — ampliación acordada por el equipo
# sobre requisitos-vistas.md § 1: solo usuario de demostración (usuario/
# contraseña "demo", sin configurar nada más) y, opcionalmente, Google.
# AUTH_SECRET es obligatorio: generar con `npx auth secret` o
# `node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"`.
AUTH_SECRET=replace_with_generated_secret
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
